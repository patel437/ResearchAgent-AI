# ============================================================
# ResearchAgent AI - Environment Variables EXAMPLE
# ============================================================
# Copy this file to backend/.env and fill in your credentials.
# NEVER commit .env to version control.

# ─── IBM watsonx.ai (Granite AI Engine) ─────────────────────────
# Required for all AI features (summarisation, gap analysis, reports …)
IBM_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Available models (us-south region, verified Nov 2026):
#   ibm/granite-4-h-small    ← recommended (Granite 4, chat API)
#   ibm/granite-4-h-medium   ← higher quality, slower
#   ibm/granite-3-1-8b-base  ← legacy, generation API
GRANITE_MODEL_ID=ibm/granite-4-h-small

# ─── IBM Cloudant (Database) ─────────────────────────────────────
# Optional — falls back to in-memory storage if not configured
CLOUDANT_URL=https://your-instance.cloudantnosqldb.appdomain.cloud
CLOUDANT_APIKEY=your_cloudant_api_key_here
CLOUDANT_DB_PROJECTS=research_projects
CLOUDANT_DB_PAPERS=research_papers
CLOUDANT_DB_REPORTS=research_reports
CLOUDANT_DB_REFERENCES=references
CLOUDANT_DB_CHATS=chat_history
CLOUDANT_DB_USERS=users

# ─── Local Document Storage ───────────────────────────────────────
# Replaces IBM COS — no paid subscription required.
# Uploaded PDFs  →  {LOCAL_STORAGE_PATH}/research_papers/{user_id}/
# Generated reports → {LOCAL_STORAGE_PATH}/generated_reports/{user_id}/
# Relative to the backend/ directory, or use an absolute path.
LOCAL_STORAGE_PATH=uploads
MAX_UPLOAD_MB=50

# ─── Application Settings ─────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ─── External Research APIs (free, no key required) ──────────────
OPENALEX_EMAIL=your_email@example.com

# ─── Demo Mode ────────────────────────────────────────────────────
# Set to true to run without IBM watsonx.ai credentials.
# Research search still works; AI features return placeholder responses.
DEMO_MODE=false
